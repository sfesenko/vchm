<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema path="/org/gnome/vchm/" id="org.gnome.vchm" gettext-domain="vchm">
    <key name="window-width" type="i">
      <default>1000</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>700</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="sash-position" type="i">
      <default>250</default>
      <summary>Sidebar sash position</summary>
    </key>
    <key name="show-topics" type="b">
      <default>true</default>
      <summary>Show topics panel</summary>
    </key>
    <key name="show-index" type="b">
      <default>true</default>
      <summary>Show index panel</summary>
    </key>
    <key name="show-search" type="b">
      <default>false</default>
      <summary>Show search panel</summary>
    </key>
    <key name="show-bookmarks" type="b">
      <default>false</default>
      <summary>Show bookmarks panel</summary>
    </key>
    <key name="active-side-panel" type="i">
      <default>0</default>
      <summary>Active side panel (0=topics, 1=index, 2=search)</summary>
    </key>
    <key name="font-size" type="i">
      <default>12</default>
      <summary>Font size</summary>
    </key>
    <key name="font-family" type="s">
      <default>'Sans'</default>
      <summary>Font family</summary>
    </key>
    <key name="fixed-font-family" type="s">
      <default>'Monospace'</default>
      <summary>Fixed font family</summary>
    </key>
    <key name="recent-files" type="as">
      <default>[]</default>
      <summary>Recent files list</summary>
    </key>
    <key name="bookmarks" type="as">
      <default>[]</default>
      <summary>Bookmarks</summary>
      <description>Per-entry: archive-path, unit separator, URL, unit separator, title.</description>
    </key>
    <key name="last-opened-dir" type="s">
      <default>''</default>
      <summary>Last opened directory</summary>
    </key>
    <key name="per-book-rows" type="as">
      <default>[]</default>
      <summary>Per-book state</summary>
      <description>Per-entry: archive-path, unit separator, last-url, unit separator, font-size, unit separator, scroll-y.</description>
    </key>
    <key name="per-book-expire-days" type="i">
      <default>180</default>
      <summary>Per-book state expiry (days)</summary>
      <description>Days after last access to keep per-book position/history; 0 means keep forever.</description>
    </key>
    <key name="bookmarks-expire-days" type="i">
      <default>180</default>
      <summary>Bookmarks expiry (days)</summary>
      <description>Days after creation to keep bookmarks; 0 means keep forever.</description>
    </key>
  </schema>
</schemalist>